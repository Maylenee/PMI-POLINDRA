# LLM Gateway Configuration
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# Optional: model name (defaults to @makers/deepseek-v4-flash)
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# Optional: embeddings model for the vector store (defaults to text-embedding-3-small).
# Uses the same AI_GATEWAY_BASE_URL / AI_GATEWAY_API_KEY. If unset or the endpoint
# has no embeddings route, a local fallback embedder is used automatically.
AI_GATEWAY_EMBED_MODEL=text-embedding-3-small
